# Server
SERVER_PORT=8081

# Database (PostgreSQL) - payment-service owns its own payment_sessions
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres_user
DB_PASSWORD=postgres_password
DB_NAME=ewallet_payment
DB_SSLMODE=disable

# JWT (shared secret with core-service - verify only)
JWT_SECRET=change-me-to-a-long-random-secret

# Core service internal API (for wallet debits)
CORE_SERVICE_URL=http://localhost:8080
CORE_SERVICE_TIMEOUT=5s
INTERNAL_API_KEY=change-me-to-a-shared-internal-key

# RabbitMQ (asynchronous payment processing)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=payment.exchange
RABBITMQ_QUEUE=payment.queue
RABBITMQ_ROUTING_KEY=payment.process
RABBITMQ_DLX=payment.dlx
RABBITMQ_DLQ=payment.queue.dlq
