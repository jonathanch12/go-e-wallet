# Root compose variables. Copy to .env and adjust for your environment.
# These are consumed by docker-compose.yml (NOT by the services' own .env files,
# which are only used when running the binaries outside Docker).

# PostgreSQL (shared instance; each service uses its own database)
DB_USER=postgres
DB_PASSWORD=admin

# Shared secrets - MUST be identical for core-service and payment-service
JWT_SECRET=change-me-to-a-long-random-secret
INTERNAL_API_KEY=change-me-to-a-shared-internal-key
